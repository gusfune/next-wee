{
  "name": "next-wee",
  "version": "0.0.0",
  "description": "Rails-grade command tooling for Next.js App Router apps",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wee": "./dist/cli.js",
    "we": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "citty": "0.2.2",
    "nypm": "0.6.9",
    "tinyexec": "1.3.1",
    "tinyglobby": "0.2.17",
    "yaml": "2.9.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "22.20.2",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
