{
  "name": "next-wee",
  "version": "0.1.0",
  "description": "Rails-grade command tooling for Next.js App Router apps",
  "type": "module",
  "license": "MIT",
  "author": "Gus Fune",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusfune/next-wee.git"
  },
  "homepage": "https://github.com/gusfune/next-wee#readme",
  "bugs": "https://github.com/gusfune/next-wee/issues",
  "bin": {
    "wee": "./dist/cli.js",
    "we": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "age-encryption": "0.3.1",
    "citty": "0.2.2",
    "date-fns": "4.1.0",
    "nypm": "0.6.9",
    "tinyexec": "1.3.1",
    "tinyglobby": "0.2.17",
    "yaml": "2.9.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-auth": "1.7.4",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.9.5",
    "resend": "6.27.0",
    "server-only": "0.0.1",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
